      m_Items: []
  - m_Id: 2266013696
    m_Localized: Enemy Attack Timer
    m_Metadata:
      m_Items: []
  - m_Id: 2266013697
    m_Localized: Displays the time until the enemy attacks. Significantly reduced
      when enraged.
