    m_Metadata:
      m_Items: []
  - m_Id: 226840632401938
    m_Localized: Fully restores party health and grants a shield equal to 20% of
      maximum health.
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401939
    m_Localized: Focus
    m_Metadata:
      m_Items: []
