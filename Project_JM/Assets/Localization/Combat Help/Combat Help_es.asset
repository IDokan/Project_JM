    m_Metadata:
      m_Items: []
  - m_Id: 620000000000006
    m_Localized: "Muestra cu\xE1ntas veces has derrotado a cada enemigo."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000007
    m_Localized: "Clasificaci\xF3n y recompensas"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000008
    m_Localized: "Muestra la mejor puntuaci\xF3n, las recompensas de esa partida
