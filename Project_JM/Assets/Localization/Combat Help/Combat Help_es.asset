  m_TableData:
  - m_Id: 2056298496
    m_Localized: Salud del grupo
    m_Metadata:
      m_Items: []
  - m_Id: 2261819392
    m_Localized: Muestra la salud restante de tu grupo.
    m_Metadata:
      m_Items: []
  - m_Id: 2261819393
    m_Localized: Salud del enemigo
    m_Metadata:
      m_Items: []
  - m_Id: 2261819394
    m_Localized: Muestra la salud restante del enemigo.
    m_Metadata:
      m_Items: []
  - m_Id: 2266013696
    m_Localized: Tiempo hasta el ataque enemigo
    m_Metadata:
      m_Items: []
  - m_Id: 2266013697
    m_Localized: Muestra el tiempo que falta para que el enemigo ataque. Se reduce
      considerablemente cuando se enfurece.
    m_Metadata:
      m_Items: []
  - m_Id: 2266013698
    m_Localized: "Combo y probabilidad de cr\xEDtico"
    m_Metadata:
      m_Items: []
  - m_Id: 2266013699
    m_Localized: "Aumenta con las combinaciones consecutivas. Los combos m\xE1s altos
      aumentan la probabilidad de golpe cr\xEDtico."
    m_Metadata:
      m_Items: []
  - m_Id: 226840519155712
    m_Localized: Potenciar al caballero
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401920
    m_Localized: Aumenta permanentemente el poder de ataque del caballero un 10%.
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401921
    m_Localized: Potenciar al arquero
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401922
    m_Localized: Aumenta permanentemente el poder de ataque del arquero un 10%.
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401923
    m_Localized: Potenciar al mago
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401924
    m_Localized: Aumenta permanentemente el poder de ataque del mago un 10%.
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401925
    m_Localized: "Potenciar al cl\xE9rigo"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401926
    m_Localized: "Aumenta permanentemente el poder de ataque del cl\xE9rigo un 10%."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401927
    m_Localized: Ataque certero del caballero
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401928
    m_Localized: "Aumenta permanentemente el da\xF1o cr\xEDtico del caballero un
      15%."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401929
    m_Localized: Ataque certero del arquero
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401930
    m_Localized: "Aumenta permanentemente el da\xF1o cr\xEDtico del arquero un 15%."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401931
    m_Localized: Ataque certero del mago
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401932
    m_Localized: "Aumenta permanentemente el da\xF1o cr\xEDtico del mago un 15%."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401933
    m_Localized: "Ataque certero del cl\xE9rigo"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401934
    m_Localized: "Aumenta permanentemente el da\xF1o cr\xEDtico del cl\xE9rigo un
      15%."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401935
    m_Localized: Furia
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401936
    m_Localized: Sacrifica el 75% de la salud actual del grupo y luego aumenta permanentemente
      el poder de ataque de todos los aliados un 10%.
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401937
    m_Localized: Bendiciones
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401938
    m_Localized: "Restaura por completo la salud del grupo y otorga un escudo equivalente
      al 20% de la salud m\xE1xima."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401939
    m_Localized: "Concentraci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401940
    m_Localized: "Ampl\xEDa permanentemente el tiempo del combo en 0,8 segundos."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401941
    m_Localized: Fortalecer
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401942
    m_Localized: "Aumenta permanentemente la salud m\xE1xima del grupo y restaura
      la misma cantidad de salud."
    m_Metadata:
      m_Items: []
  - m_Id: 592176972079104
    m_Localized: Rey de los limos
    m_Metadata:
      m_Items: []
  - m_Id: 592177165017088
    m_Localized: "Los ataques del mago y del cl\xE9rigo infligen m\xE1s da\xF1o al
