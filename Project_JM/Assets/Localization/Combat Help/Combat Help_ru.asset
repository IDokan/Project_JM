    m_Metadata:
      m_Items: []
  - m_Id: 226840632401935
    m_Localized: "\u041D\u0435\u0438\u0441\u0442\u043E\u0432\u0441\u0442\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401936
    m_Localized: "\u0416\u0435\u0440\u0442\u0432\u0443\u0435\u0442 75% \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u043E\u0442\u0440\u044F\u0434\u0430,
      \u0437\u0430\u0442\u0435\u043C \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0441\u0438\u043B\u0443
      \u0430\u0442\u0430\u043A\u0438 \u0432\u0441\u0435\u0445 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u043E\u0432
      \u043D\u0430 10%."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401937
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401938
    m_Localized: "\u041F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u043E\u0442\u0440\u044F\u0434\u0430
      \u0438 \u0434\u0430\u0451\u0442 \u0449\u0438\u0442 \u0432 \u0440\u0430\u0437\u043C\u0435\u0440\u0435
      20% \u043E\u0442 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401939
    m_Localized: "\u0421\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u0435\u043D\u0438\u0435"
