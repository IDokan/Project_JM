  m_TableData:
  - m_Id: 2056298496
    m_Localized: "\uD30C\uD2F0 \uCCB4\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 2261819392
    m_Localized: "\uD30C\uD2F0\uC758 \uB0A8\uC740 \uCCB4\uB825\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2261819393
    m_Localized: "\uC801 \uCCB4\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 2261819394
    m_Localized: "\uC801\uC758 \uB0A8\uC740 \uCCB4\uB825\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2266013696
    m_Localized: "\uC801 \uACF5\uACA9 \uD0C0\uC774\uBA38"
    m_Metadata:
      m_Items: []
  - m_Id: 2266013697
    m_Localized: "\uC801\uC774 \uACF5\uACA9\uD558\uAE30\uAE4C\uC9C0 \uB0A8\uC740
      \uC2DC\uAC04\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uC801\uC774 \uBD84\uB178\uD558\uBA74
      \uC2DC\uAC04\uC774 \uD06C\uAC8C \uC904\uC5B4\uB4ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2266013698
    m_Localized: "\uCF64\uBCF4\uC640 \uCE58\uBA85\uD0C0 \uD655\uB960"
    m_Metadata:
      m_Items: []
  - m_Id: 2266013699
    m_Localized: "\uC5F0\uC18D\uC73C\uB85C \uBCF4\uC11D\uC744 \uB9DE\uCD94\uBA74
      \uCF64\uBCF4\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4. \uCF64\uBCF4\uAC00 \uB192\uC744\uC218\uB85D
      \uCE58\uBA85\uD0C0 \uD655\uB960\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 226840519155712
    m_Localized: "\uAE30\uC0AC \uACF5\uACA9\uB825 \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401920
    m_Localized: "\uAE30\uC0AC\uC758 \uACF5\uACA9\uB825\uC774 \uC601\uAD6C\uC801\uC73C\uB85C
      10% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401921
    m_Localized: "\uAD81\uC218 \uACF5\uACA9\uB825 \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401922
    m_Localized: "\uAD81\uC218\uC758 \uACF5\uACA9\uB825\uC774 \uC601\uAD6C\uC801\uC73C\uB85C
      10% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401923
    m_Localized: "\uB9C8\uBC95\uC0AC \uACF5\uACA9\uB825 \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401924
    m_Localized: "\uB9C8\uBC95\uC0AC\uC758 \uACF5\uACA9\uB825\uC774 \uC601\uAD6C\uC801\uC73C\uB85C
      10% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401925
    m_Localized: "\uC131\uC9C1\uC790 \uACF5\uACA9\uB825 \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401926
    m_Localized: "\uC131\uC9C1\uC790\uC758 \uACF5\uACA9\uB825\uC774 \uC601\uAD6C\uC801\uC73C\uB85C
      10% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401927
    m_Localized: "\uAE30\uC0AC \uCE58\uBA85\uD0C0 \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401928
    m_Localized: "\uAE30\uC0AC\uC758 \uCE58\uBA85\uD0C0 \uD53C\uD574\uB7C9\uC774
      \uC601\uAD6C\uC801\uC73C\uB85C 15% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401929
    m_Localized: "\uAD81\uC218 \uCE58\uBA85\uD0C0 \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401930
    m_Localized: "\uAD81\uC218\uC758 \uCE58\uBA85\uD0C0 \uD53C\uD574\uB7C9\uC774
      \uC601\uAD6C\uC801\uC73C\uB85C 15% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401931
    m_Localized: "\uB9C8\uBC95\uC0AC \uCE58\uBA85\uD0C0 \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401932
    m_Localized: "\uB9C8\uBC95\uC0AC\uC758 \uCE58\uBA85\uD0C0 \uD53C\uD574\uB7C9\uC774
      \uC601\uAD6C\uC801\uC73C\uB85C 15% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401933
    m_Localized: "\uC131\uC9C1\uC790 \uCE58\uBA85\uD0C0 \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401934
    m_Localized: "\uC131\uC9C1\uC790\uC758 \uCE58\uBA85\uD0C0 \uD53C\uD574\uB7C9\uC774
      \uC601\uAD6C\uC801\uC73C\uB85C 15% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401935
    m_Localized: "\uAD11\uD3ED\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401936
    m_Localized: "\uD30C\uD2F0\uC758 \uD604\uC7AC \uCCB4\uB825 75%\uB97C \uC18C\uBAA8\uD558\uACE0,
      \uBAA8\uB4E0 \uC544\uAD70\uC758 \uACF5\uACA9\uB825\uC774 \uC601\uAD6C\uC801\uC73C\uB85C
      10% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401937
    m_Localized: "\uCD95\uBCF5"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401938
    m_Localized: "\uD30C\uD2F0\uC758 \uCCB4\uB825\uC744 \uBAA8\uB450 \uD68C\uBCF5\uD558\uACE0,
      \uCD5C\uB300 \uCCB4\uB825\uC758 20%\uC5D0 \uD574\uB2F9\uD558\uB294 \uBCF4\uD638\uB9C9\uC744
      \uC5BB\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401939
    m_Localized: "\uC9D1\uC911"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401940
    m_Localized: "\uCF64\uBCF4 \uC720\uC9C0 \uC2DC\uAC04\uC774 \uC601\uAD6C\uC801\uC73C\uB85C
      0.8\uCD08 \uB298\uC5B4\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401941
    m_Localized: "\uCCB4\uB825 \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401942
    m_Localized: "\uD30C\uD2F0\uC758 \uCD5C\uB300 \uCCB4\uB825\uC774 \uC601\uAD6C\uC801\uC73C\uB85C
      \uC99D\uAC00\uD558\uACE0, \uC99D\uAC00\uD55C \uB9CC\uD07C \uCCB4\uB825\uC744
      \uD68C\uBCF5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 592176972079104
    m_Localized: "\uC2AC\uB77C\uC784 \uC655"
    m_Metadata:
      m_Items: []
  - m_Id: 592177165017088
    m_Localized: "\uB9C8\uBC95\uC0AC\uC640 \uC131\uC9C1\uC790\uC758 \uACF5\uACA9\uC740
      \uC2AC\uB77C\uC784 \uC655\uC5D0\uAC8C \uB354 \uD070 \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 592177165017089
    m_Localized: "\uAC1C\uBBF8 \uAC80\uD22C\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 592177165017090
    m_Localized: "\uAE30\uC0AC\uC640 \uB9C8\uBC95\uC0AC\uC758 \uACF5\uACA9\uC740
      \uAC1C\uBBF8 \uAC80\uD22C\uC0AC\uC5D0\uAC8C \uB354 \uD070 \uD53C\uD574\uB97C
      \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 592177165017091
    m_Localized: "\uBC84\uC12F \uAE61\uD328"
    m_Metadata:
      m_Items: []
  - m_Id: 592177165017092
    m_Localized: "\uAE30\uC0AC\uC640 \uC131\uC9C1\uC790\uC758 \uACF5\uACA9\uC740
      \uBC84\uC12F \uAE61\uD328\uC5D0\uAC8C \uB354 \uD070 \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 592177169211392
    m_Localized: "\uC5EC\uC6B0 \uB3C4\uB451"
    m_Metadata:
      m_Items: []
  - m_Id: 592177169211393
    m_Localized: "\uAE30\uC0AC\uC640 \uAD81\uC218\uC758 \uACF5\uACA9\uC740 \uC5EC\uC6B0
      \uB3C4\uB451\uC5D0\uAC8C \uB354 \uD070 \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 592177169211394
    m_Localized: "\uB2EC\uD33D\uC774 \uB9C8\uBC95\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 592177169211395
    m_Localized: "\uAD81\uC218\uC640 \uB9C8\uBC95\uC0AC\uC758 \uACF5\uACA9\uC740
      \uB2EC\uD33D\uC774 \uB9C8\uBC95\uC0AC\uC5D0\uAC8C \uB354 \uD070 \uD53C\uD574\uB97C
      \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 592177169211396
    m_Localized: "\uBBFC\uB4E4\uB808 \uB450\uAEBC\uBE44"
    m_Metadata:
      m_Items: []
  - m_Id: 592177169211397
    m_Localized: "\uAD81\uC218\uC640 \uC131\uC9C1\uC790\uC758 \uACF5\uACA9\uC740
      \uBBFC\uB4E4\uB808 \uB450\uAEBC\uBE44\uC5D0\uAC8C \uB354 \uD070 \uD53C\uD574\uB97C
      \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 592177169211398
    m_Localized: "\uB0A0\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 592177169211399
    m_Localized: "\uAE30\uC0AC\uC640 \uB9C8\uBC95\uC0AC\uC758 \uACF5\uACA9\uC740
      \uB0A0\uCE58\uC5D0\uAC8C \uB354 \uD070 \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 612594680373248
    m_Localized: "\uD53C\uD574 \uAE30\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 612594873311232
    m_Localized: "\uC4F0\uB7EC\uB728\uB9B0 \uC801\uC5D0\uAC8C \uAC01 \uC0C9\uC0C1\uC774
      \uC900 \uD53C\uD574\uB7C9\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000001
    m_Localized: "\uB204\uC801 \uBCF4\uC11D \uB9E4\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000002
    m_Localized: "\uC0C9\uC0C1\uACFC \uB9E4\uCE58 \uD06C\uAE30\uBCC4 \uB204\uC801
      \uBCF4\uC11D \uB9E4\uCE58 \uD69F\uC218 \uBC0F \uCD5C\uACE0 \uCF64\uBCF4\uB97C
      \uD45C\uC2DC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000003
    m_Localized: "\uB204\uC801 \uD53C\uD574\uB7C9"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000004
    m_Localized: "\uAC01 \uD30C\uD2F0\uC6D0\uC774 \uC9C0\uAE08\uAE4C\uC9C0 \uC900
      \uCD1D \uD53C\uD574\uB7C9\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000005
    m_Localized: "\uCC98\uCE58\uD55C \uC801"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000006
    m_Localized: "\uAC01 \uC801\uC744 \uCC98\uCE58\uD55C \uD69F\uC218\uB97C \uD45C\uC2DC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000007
    m_Localized: "\uC21C\uC704\uC640 \uBCF4\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000008
    m_Localized: "\uCD5C\uACE0 \uC810\uC218\uC640 \uD574\uB2F9 \uD50C\uB808\uC774\uC758
      \uBCF4\uC0C1 \uAE30\uB85D, \uC9C0\uAE08\uAE4C\uC9C0 \uC120\uD0DD\uD55C \uBCF4\uC0C1
      \uB0B4\uC5ED\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000009
    m_Localized: "\uC804\uCCB4 \uC74C\uB7C9"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000010
    m_Localized: "\uAC8C\uC784\uC758 \uBAA8\uB4E0 \uC18C\uB9AC \uD06C\uAE30\uB97C
      \uC870\uC808\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000011
    m_Localized: "\uD6A8\uACFC\uC74C \uC74C\uB7C9"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000012
    m_Localized: "\uD6A8\uACFC\uC74C\uC758 \uD06C\uAE30\uB97C \uC870\uC808\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000013
    m_Localized: "\uBC30\uACBD \uC74C\uC545 \uC74C\uB7C9"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000014
    m_Localized: "\uBC30\uACBD \uC74C\uC545\uC758 \uD06C\uAE30\uB97C \uC870\uC808\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000015
    m_Localized: "\uD654\uBA74 \uD574\uC0C1\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000016
    m_Localized: "\uD654\uBA74 \uD574\uC0C1\uB3C4\uB97C \uBCC0\uACBD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000017
    m_Localized: "\uC804\uCCB4 \uD654\uBA74 \uBAA8\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000018
    m_Localized: "\uC804\uCCB4 \uD654\uBA74 \uBAA8\uB4DC\uC640 \uCC3D \uBAA8\uB4DC\uB97C
      \uC804\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1358047587901440
    m_Localized: "\uAE30\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 1358119813816320
    m_Localized: "\uBE68\uAC04 \uBCF4\uC11D\uC758 \uC601\uC6C5\uC785\uB2C8\uB2E4.
      \uBCF4\uC11D 4\uAC1C\uB97C \uB9DE\uCD94\uBA74 \uBCF4\uD638\uB9C9\uC744 \uC5BB\uACE0,
      5\uAC1C\uB97C \uB9DE\uCD94\uBA74 \uC801\uC744 5\uCD08 \uB3D9\uC548 \uAE30\uC808\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1358152973983744
    m_Localized: "\uAD81\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 1358200407367680
    m_Localized: "\uCD08\uB85D \uBCF4\uC11D\uC758 \uC601\uC6C5\uC785\uB2C8\uB2E4.
      \uBCF4\uC11D 4\uAC1C\uB97C \uB9DE\uCD94\uBA74 \uCE58\uBA85\uD0C0 \uD655\uB960\uC774
      5\uCD08 \uB3D9\uC548 \uC99D\uAC00\uD558\uACE0, 5\uAC1C\uB97C \uB9DE\uCD94\uBA74
      \uD604\uC7AC \uC801\uC744 \uCC98\uCE58\uD560 \uB54C\uAE4C\uC9C0 \uD574\uB2F9
      \uC801\uC5D0\uAC8C \uC8FC\uB294 \uCE58\uBA85\uD0C0 \uD53C\uD574\uB7C9\uC774
      \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1358348835397632
    m_Localized: "\uB9C8\uBC95\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 1358388689674240
    m_Localized: "\uD30C\uB780 \uBCF4\uC11D\uC758 \uC601\uC6C5\uC785\uB2C8\uB2E4.
      \uBCF4\uC11D 4\uAC1C\uB97C \uB9DE\uCD94\uBA74 \uC801\uC758 \uACF5\uACA9\uC744
      2\uCD08 \uC9C0\uC5F0\uC2DC\uD0A4\uACE0, 5\uAC1C\uB97C \uB9DE\uCD94\uBA74 8\uCD08
      \uB3D9\uC548 \uC2DC\uAC04\uC744 \uB290\uB9AC\uAC8C \uB9CC\uB4ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1358784036380672
    m_Localized: "\uC131\uC9C1\uC790"
    m_Metadata:
