  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Combat Help_ro
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ro
  m_SharedData: {fileID: 11400000, guid: 40d56d81d8fa86345a7cac2ee20f221d, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2056298496
    m_Localized: "Via\u021Ba echipei"
    m_Metadata:
      m_Items: []
  - m_Id: 2261819392
    m_Localized: "Arat\u0103 via\u021Ba r\u0103mas\u0103 a echipei tale."
    m_Metadata:
      m_Items: []
  - m_Id: 2261819393
    m_Localized: "Via\u021Ba inamicului"
    m_Metadata:
      m_Items: []
  - m_Id: 2261819394
    m_Localized: "Arat\u0103 via\u021Ba r\u0103mas\u0103 a inamicului."
    m_Metadata:
      m_Items: []
  - m_Id: 2266013696
    m_Localized: "Timp p\xE2n\u0103 la atacul inamicului"
    m_Metadata:
      m_Items: []
  - m_Id: 2266013697
    m_Localized: "Arat\u0103 timpul r\u0103mas p\xE2n\u0103 la atacul inamicului.
      Acesta se reduce considerabil c\xE2nd inamicul se \xEEnfurie."
    m_Metadata:
      m_Items: []
  - m_Id: 2266013698
    m_Localized: "Combo \u0219i \u0219ans\u0103 de lovitur\u0103 critic\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 2266013699
    m_Localized: "Combo-ul cre\u0219te cu potrivirile consecutive. Un combo mai mare
      cre\u0219te \u0219ansa de lovitur\u0103 critic\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 226840519155712
    m_Localized: "\xCEnt\u0103rirea cavalerului"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401920
    m_Localized: "Cre\u0219te permanent puterea de atac a cavalerului cu 10%."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401921
    m_Localized: "\xCEnt\u0103rirea arca\u0219ului"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401922
    m_Localized: "Cre\u0219te permanent puterea de atac a arca\u0219ului cu 10%."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401923
    m_Localized: "\xCEnt\u0103rirea magului"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401924
    m_Localized: "Cre\u0219te permanent puterea de atac a magului cu 10%."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401925
    m_Localized: "\xCEnt\u0103rirea clericului"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401926
    m_Localized: "Cre\u0219te permanent puterea de atac a clericului cu 10%."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401927
    m_Localized: Atac precis al cavalerului
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401928
    m_Localized: "Cre\u0219te permanent daunele critice ale cavalerului cu 15%."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401929
    m_Localized: "Atac precis al arca\u0219ului"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401930
    m_Localized: "Cre\u0219te permanent daunele critice ale arca\u0219ului cu 15%."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401931
    m_Localized: Atac precis al magului
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401932
    m_Localized: "Cre\u0219te permanent daunele critice ale magului cu 15%."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401933
    m_Localized: Atac precis al clericului
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401934
    m_Localized: "Cre\u0219te permanent daunele critice ale clericului cu 15%."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401935
    m_Localized: Furie
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401936
    m_Localized: "Sacrific\u0103 75% din via\u021Ba actual\u0103 a echipei, apoi
      cre\u0219te permanent puterea de atac a tuturor alia\u021Bilor cu 10%."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401937
    m_Localized: "Binecuv\xE2nt\u0103ri"
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401938
    m_Localized: "Reface complet via\u021Ba echipei \u0219i ofer\u0103 un scut egal
      cu 20% din via\u021Ba maxim\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401939
    m_Localized: Concentrare
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401940
    m_Localized: "Prelunge\u0219te permanent durata combo-ului cu 0,8 secunde."
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401941
    m_Localized: Fortificare
    m_Metadata:
      m_Items: []
  - m_Id: 226840632401942
    m_Localized: "Cre\u0219te permanent via\u021Ba maxim\u0103 a echipei \u0219i
      reface aceea\u0219i cantitate de via\u021B\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 592176972079104
    m_Localized: "Regele m\xE2zgelor"
    m_Metadata:
      m_Items: []
  - m_Id: 592177165017088
    m_Localized: "Atacurile magului \u0219i ale clericului provoac\u0103 daune sporite
      regelui m\xE2zgelor."
    m_Metadata:
      m_Items: []
  - m_Id: 592177165017089
    m_Localized: Furnica gladiatoare
    m_Metadata:
      m_Items: []
  - m_Id: 592177165017090
    m_Localized: "Atacurile cavalerului \u0219i ale magului provoac\u0103 daune sporite
      furnicii gladiatoare."
    m_Metadata:
      m_Items: []
  - m_Id: 592177165017091
    m_Localized: "Ciuperca b\u0103t\u0103u\u0219\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 592177165017092
    m_Localized: "Atacurile cavalerului \u0219i ale clericului provoac\u0103 daune
      sporite ciupercii b\u0103t\u0103u\u0219e."
    m_Metadata:
      m_Items: []
  - m_Id: 592177169211392
    m_Localized: "Vulpea hoa\u021B\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 592177169211393
    m_Localized: "Atacurile cavalerului \u0219i ale arca\u0219ului provoac\u0103
      daune sporite vulpii hoa\u021Be."
    m_Metadata:
      m_Items: []
  - m_Id: 592177169211394
    m_Localized: "Melcul vr\u0103jitor"
    m_Metadata:
      m_Items: []
  - m_Id: 592177169211395
    m_Localized: "Atacurile arca\u0219ului \u0219i ale magului provoac\u0103 daune
      sporite melcului vr\u0103jitor."
    m_Metadata:
      m_Items: []
  - m_Id: 592177169211396
    m_Localized: "Broscoiul p\u0103p\u0103die"
    m_Metadata:
      m_Items: []
  - m_Id: 592177169211397
    m_Localized: "Atacurile arca\u0219ului \u0219i ale clericului provoac\u0103 daune
      sporite broscoiului p\u0103p\u0103die."
    m_Metadata:
      m_Items: []
  - m_Id: 592177169211398
    m_Localized: "Pe\u0219tele zbur\u0103tor"
    m_Metadata:
      m_Items: []
  - m_Id: 592177169211399
    m_Localized: "Atacurile cavalerului \u0219i ale magului provoac\u0103 daune sporite
      pe\u0219telui zbur\u0103tor."
    m_Metadata:
      m_Items: []
  - m_Id: 612594680373248
    m_Localized: Raport de daune
    m_Metadata:
      m_Items: []
  - m_Id: 612594873311232
    m_Localized: "Arat\u0103 c\xE2te daune a provocat fiecare culoare inamicului
      \xEEnvins."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000001
    m_Localized: Total potriviri de nestemate
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000002
    m_Localized: "Arat\u0103 potrivirile de nestemate din toate partidele, dup\u0103
      culoare \u0219i m\u0103rime, precum \u0219i cel mai mare combo."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000003
    m_Localized: Total daune provocate
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000004
    m_Localized: "Arat\u0103 daunele provocate de fiecare membru al echipei \xEEn
      toate partidele."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000005
    m_Localized: "Inamici \xEEnvin\u0219i"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000006
    m_Localized: "Arat\u0103 de c\xE2te ori a fost \xEEnvins fiecare inamic."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000007
    m_Localized: "Clasament \u0219i recompense"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000008
    m_Localized: "Arat\u0103 cel mai bun scor, istoricul recompenselor din acea partid\u0103
      \u0219i recompensele alese \xEEn toate partidele."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000009
    m_Localized: Volum general
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000010
    m_Localized: "Regleaz\u0103 volumul tuturor sunetelor din joc."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000011
    m_Localized: Volumul efectelor sonore
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000012
    m_Localized: "Regleaz\u0103 volumul efectelor sonore."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000013
    m_Localized: Volumul muzicii
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000014
    m_Localized: "Regleaz\u0103 volumul muzicii de fundal."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000015
    m_Localized: "Rezolu\u021Bia ecranului"
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000016
    m_Localized: "Schimb\u0103 rezolu\u021Bia ecranului."
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000017
    m_Localized: Mod ecran complet
    m_Metadata:
      m_Items: []
  - m_Id: 620000000000018
    m_Localized: "Comut\u0103 \xEEntre modul ecran complet \u0219i modul fereastr\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 1358047587901440
    m_Localized: Cavaler
    m_Metadata:
      m_Items: []
  - m_Id: 1358119813816320
    m_Localized: "Eroul nestematelor ro\u0219ii. O potrivire de 4 nestemate ofer\u0103
      un scut, iar una de 5 ame\u021Be\u0219te inamicii timp de 5 secunde."
    m_Metadata:
      m_Items: []
  - m_Id: 1358152973983744
    m_Localized: "Arca\u0219"
    m_Metadata:
      m_Items: []
  - m_Id: 1358200407367680
    m_Localized: "Eroul nestematelor verzi. O potrivire de 4 nestemate cre\u0219te
      \u0219ansa de lovitur\u0103 critic\u0103 timp de 5 secunde, iar una de 5 cre\u0219te
      daunele critice \xEEmpotriva inamicului actual p\xE2n\u0103 la \xEEnfr\xE2ngerea
      lui."
    m_Metadata:
      m_Items: []
  - m_Id: 1358348835397632
    m_Localized: Mag
    m_Metadata:
      m_Items: []
  - m_Id: 1358388689674240
    m_Localized: "Eroul nestematelor albastre. O potrivire de 4 nestemate am\xE2n\u0103
      atacul inamicului cu 2 secunde, iar una de 5 \xEEncetine\u0219te timpul pentru
      8 secunde."
    m_Metadata:
      m_Items: []
  - m_Id: 1358784036380672
    m_Localized: Cleric
    m_Metadata:
      m_Items: []
  - m_Id: 1358814461861888
    m_Localized: "Eroul nestematelor galbene. O potrivire de 4 nestemate reface via\u021Ba
      echipei, iar una de 5 cre\u0219te puterea de atac a echipei."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
